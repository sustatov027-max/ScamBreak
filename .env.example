# ==============================================================================
# ScamBreak System - Unified Configuration (.env)
# ==============================================================================
# Единый конфигурационный файл для всех микросервисов проекта.
# Автоматически обнаруживается и загружается пакетом pkg/config при старте любого сервиса.

# ==============================================================================
# 1. ОБЩИЕ ПАРАМЕТРЫ (ДЛЯ ВСЕХ МИКРОСЕРВИСОВ)
# ==============================================================================
APP_ENV=development                # local | development | production

# Логирование (slog)
LOG_LEVEL=info                     # debug | info | warn | error
LOG_FORMAT=text                    # text (для консоли) | json (для prod/контейнеров)
LOG_ADD_SOURCE=false               # true — выводить файл и номер строки

# Общие параметры PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Общий брокер Apache Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=scambreak-group

# Открытый ключ RSA для проверки подписи JWT токенов (нужен всем сервисам)
JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem
JWT_EXPIRATION=24h

# Общие таймауты серверов
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# ==============================================================================
# 2. USER / PROFILE SERVICE (Префикс: USER_)
# ==============================================================================
USER_HTTP_PORT=8081
USER_GRPC_PORT=50051
USER_DB_PORT=5431
USER_DB_NAME=user_db
USER_JWT_PRIVATE_KEY_PATH=certs/jwt_private.pem   # Закрытый ключ для выпуска JWT

# ==============================================================================
# 3. PAYMENT SERVICE (Префикс: PAYMENT_)
# ==============================================================================
PAYMENT_HTTP_PORT=8082
PAYMENT_DB_PORT=5433
PAYMENT_DB_NAME=payment_db
PAYMENT_USER_SERVICE_GRPC_ADDR=localhost:50051

# ==============================================================================
# 4. FRAUD DETECTION SERVICE (Префикс: FRAUD_)
# ==============================================================================
FRAUD_HTTP_PORT=8083
FRAUD_DB_PORT=5434
FRAUD_DB_NAME=fraud_db
FRAUD_REDIS_HOST=localhost
FRAUD_REDIS_PORT=6379
FRAUD_USER_SERVICE_GRPC_ADDR=localhost:50051

# ==============================================================================
# 5. NOTIFICATION / INCIDENT SERVICE (Префикс: NOTIFICATION_)
# ==============================================================================
NOTIFICATION_HTTP_PORT=8084
NOTIFICATION_DB_PORT=5435
NOTIFICATION_DB_NAME=notification_db
